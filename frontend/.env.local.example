# Copy to .env.local and fill in for local development.
# No .env.local is committed — Vercel/Lovable injects these in deployed environments.

# Backend API base (FastAPI, prefix included). Defaults to http://localhost:8000/api/v1 if unset.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project (auth). Required for sign-in/sign-up/session to work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" to skip the /dashboard auth-guard redirect during local UI work
# without a live backend/Supabase session.
VITE_DEV_AUTH_BYPASS=false

# SEO meta tag only, safe to leave blank locally.
VITE_GOOGLE_SITE_VERIFICATION=
